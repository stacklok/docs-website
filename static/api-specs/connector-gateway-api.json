                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Current connector ETag. Missing -\u003e 428; stale -\u003e 412.",
                        "in": "header",
                        "name": "If-Match",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
