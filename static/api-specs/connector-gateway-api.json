                            "schema": {
                                "oneOf": [
                                    {
                                        "type": "object"
                                    },
                                    {
                                        "$ref": "#/components/schemas/PutConnectorRequest",
                                        "summary": "body",
                                        "description": "Desired state"
                                    }
                                ]
                            }
